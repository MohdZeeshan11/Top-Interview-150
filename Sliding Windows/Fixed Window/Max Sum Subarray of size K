// brute force solution
class Solution {
    public int maxSubarraySum(int[] arr, int k) {
        int maxSum = Integer.MIN_VALUE;

        for (int i = 0; i <= arr.length - k; i++) {
            int sum = 0;

            for (int j = i; j < i + k; j++) {
                sum += arr[j];
            }

            maxSum = Math.max(maxSum, sum);
        }

        return maxSum;
    }
}

// optimized solution using sliding window technique
class Solution {
    public int maxSubarraySum(int[] arr, int k) {  
              
        int j = 0;
        int maxSum = 0; // if all array elements are positive if numbers are negative then we can take maxSum = Integer.MIN_VALUE
        int sum = 0;
        int i = 0;
        while(i < arr.length){
            sum = sum + arr[i];
            if(i - j + 1 == k){
                maxSum = Math.max(sum, maxSum);
                sum = sum - arr[j];
                j++;
            }
            i++;
        }
        return maxSum;
    }
}