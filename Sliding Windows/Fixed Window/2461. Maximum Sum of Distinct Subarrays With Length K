class Solution {
    public long maximumSubarraySum(int[] nums, int k) {

        Set<Integer> set = new HashSet<>();
        long maxSum = 0;
        int i = 0;
        int j = 0;
        long sum = 0;
        while (j < nums.length) {
            if (!set.contains(nums[j])) {
                set.add(nums[j]);
                sum = sum + nums[j];
                if (set.size() == k) {
                    maxSum = Math.max(sum, maxSum);
                    sum = sum - nums[i];
                    set.remove(nums[i]);
                    i++;
                }
                j++;
            } else {
                set.remove(nums[i]);
                sum = sum - nums[i];
                i++;
            }
        }
        return maxSum;
    }
}