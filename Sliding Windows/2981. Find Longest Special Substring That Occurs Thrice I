class Solution {
    public int maximumLength(String s) {
        
        HashMap<String, Integer> map = new HashMap<>();

        for(int i = 0; i < s.length(); i++){
            for(int j = i; j < s.length(); j++){
                map.put(s.substring(i, j+1), map.getOrDefault(s.substring(i, j+1), 0)+1);
            }
        }

        int count = -1;
        for(Map.Entry<String, Integer> entry : map.entrySet()){
            if(entry.getValue() >= 3 && isValid(entry.getKey())){
                count = Math.max(count, entry.getKey().length());
            }
        }
        return count;
    }

    public boolean isValid(String s){
        char firstChar = s.charAt(0);

        for(int i = 1; i < s.length(); i++){
            if(firstChar != s.charAt(i)){
                return false;
            }
        }
        return true;
    }
}

more optimized brute force code
class Solution {
    public int maximumLength(String s) {

        HashMap<String, Integer> map = new HashMap<>();

        for (int i = 0; i < s.length(); i++) {
            char firstChar = s.charAt(i);
            for (int j = i; j < s.length(); j++) {
                if (firstChar != s.charAt(j)) {
                    break;
                }
                String str = s.substring(i, j + 1);
                map.put(str, map.getOrDefault(str, 0) + 1);
            }
        }

        int count = -1;
        for (Map.Entry<String, Integer> entry : map.entrySet()) {
            if (entry.getValue() >= 3) {
                count = Math.max(count, entry.getKey().length());
            }
        }
        return count;
    }

